generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Activity {
  id         String   @id @default(uuid())
  title      String
  type       String   @default("WORDLE")
  targetWord String
  difficulty String   @default("MEDIUM")
  phonemes   String   @default("")
  createdAt  DateTime @default(now())
  words      Word[]
}

model Word {
  id         String   @id @default(uuid())
  text       String
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}